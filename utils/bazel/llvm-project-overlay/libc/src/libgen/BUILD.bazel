load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "basename",
    srcs = ["basename.cpp"],
    hdrs = ["basename.h"],
    deps = [
        "//libc/src/__support:common",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "dirname",
    srcs = ["dirname.cpp"],
    hdrs = ["dirname.h"],
    deps = [
        "//libc/src/__support:common",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/macros:config",
    ],
)
