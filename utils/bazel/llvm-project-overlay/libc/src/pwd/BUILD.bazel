    name = "setpwent",
    srcs = ["setpwent.cpp"],
    hdrs = ["setpwent.h"],
    deps = [
        ":pwd_utils",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/macros:config",
        "//libc/src/errno",
    ],
)

libc_function(
    name = "getpwent_r",
    srcs = ["getpwent_r.cpp"],
    hdrs = ["getpwent_r.h"],
    deps = [
        ":pwd_utils",
        "//libc/hdr:errno_macros",
        "//libc/hdr/types:size_t",
        "//libc/hdr/types:struct_passwd",
