load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "utils",
    hdrs = ["ether_utils.h"],
    deps = [
        "//libc/hdr:stdint_proxy",
        "//libc/hdr/types:size_t",
        "//libc/hdr/types:struct_ether_addr",
        "//libc/src/__support:common",
        "//libc/src/__support:ctype_utils",
        "//libc/src/__support/CPP:optional",
        "//libc/src/__support/CPP:span",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/net:hex",
    ],
)

libc_function(
    name = "ether_aton",
    srcs = ["ether_aton.cpp"],
    hdrs = ["ether_aton.h"],
    deps = [
        ":utils",
        "//libc/hdr/types:struct_ether_addr",
        "//libc/src/__support:common",
        "//libc/src/__support/CPP:optional",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros:null_check",
    ],
)

libc_function(
    name = "ether_aton_r",
    srcs = ["ether_aton_r.cpp"],
    hdrs = ["ether_aton_r.h"],
    deps = [
        ":utils",
        "//libc/hdr/types:struct_ether_addr",
        "//libc/src/__support:common",
        "//libc/src/__support/CPP:optional",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros:null_check",
    ],
)

libc_function(
    name = "ether_ntoa",
    srcs = ["ether_ntoa.cpp"],
    hdrs = ["ether_ntoa.h"],
    deps = [
        ":utils",
        "//libc/hdr/types:struct_ether_addr",
        "//libc/src/__support:common",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros:null_check",
    ],
)

libc_function(
    name = "ether_ntoa_r",
    srcs = ["ether_ntoa_r.cpp"],
    hdrs = ["ether_ntoa_r.h"],
    deps = [
        ":utils",
        "//libc/hdr/types:struct_ether_addr",
        "//libc/src/__support:common",
        "//libc/src/__support/CPP:span",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros:null_check",
    ],
)
