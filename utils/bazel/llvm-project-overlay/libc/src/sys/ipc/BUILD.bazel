load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "ftok",
    srcs = ["linux/ftok.cpp"],
    hdrs = ["ftok.h"],
    deps = [
        "//libc/hdr:fcntl_macros",
        "//libc/hdr/types:key_t",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/OSUtil:linux_stat_kernel_statx_types",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:statx",
        "//libc/src/__support/macros:config",
        "//libc/src/errno",
    ],
)
