load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "eventfd",
    srcs = ["linux/eventfd.cpp"],
    hdrs = ["eventfd.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:eventfd",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "eventfd_read",
    srcs = ["linux/eventfd_read.cpp"],
    hdrs = ["eventfd_read.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr/types:eventfd_t",
        "//libc/hdr/types:ssize_t",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:read",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "eventfd_write",
    srcs = ["linux/eventfd_write.cpp"],
    hdrs = ["eventfd_write.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr/types:eventfd_t",
        "//libc/hdr/types:ssize_t",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:write",
        "//libc/src/__support/macros:config",
    ],
)
