load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "inotify_add_watch",
    srcs = ["linux/inotify_add_watch.cpp"],
    hdrs = ["inotify_add_watch.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libc/hdr:stdint_proxy",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:inotify_add_watch",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "inotify_init",
    srcs = ["linux/inotify_init.cpp"],
    hdrs = ["inotify_init.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:inotify_init",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "inotify_init1",
    srcs = ["linux/inotify_init1.cpp"],
    hdrs = ["inotify_init1.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:inotify_init1",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "inotify_rm_watch",
    srcs = ["linux/inotify_rm_watch.cpp"],
    hdrs = ["inotify_rm_watch.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:inotify_rm_watch",
        "//libc/src/__support/macros:config",
    ],
)
