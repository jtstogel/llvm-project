load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "major",
    srcs = ["linux/major.cpp"],
    hdrs = ["major.h"],
    deps = [
        "//libc/hdr/types:dev_t",
        "//libc/src/__support:common",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "makedev",
    srcs = ["linux/makedev.cpp"],
    hdrs = ["makedev.h"],
    deps = [
        "//libc/hdr/types:dev_t",
        "//libc/src/__support:common",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "minor",
    srcs = ["linux/minor.cpp"],
    hdrs = ["minor.h"],
    deps = [
        "//libc/hdr/types:dev_t",
        "//libc/src/__support:common",
        "//libc/src/__support/macros:config",
    ],
)
