load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "_r_debug",
    srcs = ["_r_debug.cpp"],
    hdrs = ["_r_debug.h"],
    deps = [
        "//libc/hdr/types:struct_r_debug",
        "//libc/src/__support:common",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "dl_iterate_phdr",
    srcs = ["dl_iterate_phdr.cpp"],
    hdrs = ["dl_iterate_phdr.h"],
    full_build_only = True,
    deps = [
        "//libc/hdr/types:struct_dl_phdr_info",
        "//libc/include:llvm_libc_macros_link_macros",
        "//libc/include:llvm_libc_types___dl_iterate_phdr_callback_t",
        "//libc/src/__support:common",
        "//libc/src/__support/CPP:span",
        "//libc/src/__support/OSUtil:linux_auxv",
        "//libc/src/__support/macros:config",
    ],
)
