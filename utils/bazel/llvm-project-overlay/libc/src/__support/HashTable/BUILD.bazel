load("//libc:libc_build_rules.bzl", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "randomness",
    hdrs = ["randomness.h"],
    # DO NOT SUBMIT: LIBC_HASHTABLE_USE_GETRANDOM is omitted here because
    # per-target defines are disallowed on overlay-compatible targets (they are
    # dropped by libc_release_library). Move LIBC_HASHTABLE_USE_GETRANDOM into
    # LIBC_CONFIGURE_OPTIONS if needed (along with the errno_macros and
    # getrandom deps guarded by #if defined(LIBC_HASHTABLE_USE_GETRANDOM)).
    deps = [
        "//libc/src/__support:common",
        "//libc/src/__support:hash",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
    ],
)

libc_support_library(
    name = "bitmask",
    hdrs = ["bitmask.h"],
    textual_hdrs = [
        "generic/bitmask_impl.inc",
        "sse2/bitmask_impl.inc",
    ],
    deps = [
        "//libc/hdr:stdint_proxy",
        "//libc/src/__support:common",
        "//libc/src/__support/CPP:bit",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros/properties:cpu_features",
    ],
)

libc_support_library(
    name = "table",
    hdrs = ["table.h"],
    deps = [
        ":bitmask",
        "//libc/hdr:stdint_proxy",
        "//libc/hdr/types:entry",
        "//libc/src/__support:alloc_checker",
        "//libc/src/__support:hash",
        "//libc/src/__support:memory_size",
        "//libc/src/__support/CPP:bit",
        "//libc/src/__support/CPP:new",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros:optimization",
        "//libc/src/string:utils",
        "//libc/src/string/memory_utils",
    ],
)
