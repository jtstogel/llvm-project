load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "net_linux_if_nameindex_impl",
    hdrs = ["linux/if_nameindex_impl.h"],
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr:net_if_macros",
        "//libc/hdr:sys_socket_macros",
        "//libc/hdr/types:socklen_t",
        "//libc/hdr/types:ssize_t",
        "//libc/hdr/types:struct_if_nameindex",
        "//libc/src/__support:alloc_checker",
        "//libc/src/__support:blockstore",
        "//libc/src/__support:checked_ptr",
        "//libc/src/__support:common",
        "//libc/src/__support:error_or",
        "//libc/src/__support/CPP:new",
        "//libc/src/__support/CPP:scope",
        "//libc/src/__support/CPP:span",
        "//libc/src/__support/CPP:unique_ptr",
        "//libc/src/string:utils",
        "//libc/src/string/memory_utils",
    ],
)

libc_function(
    name = "if_freenameindex",
    srcs = ["linux/if_freenameindex.cpp"],
    hdrs = ["if_freenameindex.h"],
    full_build_only = True,
    deps = [
        "//libc/hdr:stdint_proxy",
        "//libc/hdr/types:struct_if_nameindex",
        "//libc/src/__support:common",
        "//libc/src/__support/CPP:new",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "if_nameindex",
    srcs = ["linux/if_nameindex.cpp"],
    hdrs = ["if_nameindex.h"],
    full_build_only = True,
    deps = [
        ":net_linux_if_nameindex_impl",
        "//libc/hdr/types:struct_if_nameindex",
        "//libc/src/__support:common",
        "//libc/src/__support:error_or",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/OSUtil:linux_network_syscall_policy",
        "//libc/src/__support/macros:config",
        "//libc/src/errno",
    ],
)

libc_function(
    name = "if_indextoname",
    srcs = ["linux/if_indextoname.cpp"],
    hdrs = ["if_indextoname.h"],
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr:net_if_macros",
        "//libc/hdr:sys_ioctl_macros",
        "//libc/hdr:sys_socket_macros",
        "//libc/hdr/types:struct_ifreq",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:close",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:ioctl",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:socket",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros:null_check",
        "//libc/src/errno",
        "//libc/src/string:utils",
        "//libc/src/string/memory_utils",
    ],
)

libc_function(
    name = "if_nametoindex",
    srcs = ["linux/if_nametoindex.cpp"],
    hdrs = ["if_nametoindex.h"],
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr:net_if_macros",
        "//libc/hdr:sys_ioctl_macros",
        "//libc/hdr:sys_socket_macros",
        "//libc/hdr/types:struct_ifreq",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:close",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:ioctl",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:socket",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros:null_check",
        "//libc/src/errno",
        "//libc/src/string/memory_utils",
    ],
)
