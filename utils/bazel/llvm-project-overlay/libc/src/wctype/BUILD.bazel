load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "iswctype",
    srcs = ["iswctype.cpp"],
    hdrs = ["iswctype.h"],
    deps = [
        "//libc/hdr/types:wctype_t",
        "//libc/hdr/types:wint_t",
        "//libc/src/__support:common",
        "//libc/src/__support:wctype_impl",
    ],
)

libc_function(
    name = "wctype",
    srcs = ["wctype.cpp"],
    hdrs = ["wctype_impl.h"],
    deps = [
        "//libc/hdr/types:wctype_t",
        "//libc/hdr/types:wint_t",
        "//libc/src/__support:common",
        "//libc/src/__support:wctype_impl",
    ],
)
