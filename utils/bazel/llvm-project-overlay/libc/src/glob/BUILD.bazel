load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "glob",
    srcs = ["glob.cpp"],
    hdrs = ["glob.h"],
    full_build_only = True,
    deps = [
        "//libc/hdr:glob_macros",
        "//libc/hdr/types:glob_t",
        "//libc/src/__support:common",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "globfree",
    srcs = ["globfree.cpp"],
    hdrs = ["globfree.h"],
    full_build_only = True,
    deps = [
        "//libc/hdr/types:glob_t",
        "//libc/src/__support:common",
        "//libc/src/__support/macros:config",
    ],
)
