# Tests for LLVM libc termios functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "termios_test",
    srcs = ["termios_test.cpp"],
    deps = [
        "//libc/hdr:termios_macros",
        "//libc/hdr/types:struct_termios",
        "//libc/src/fcntl:open",
        "//libc/src/termios:cfgetispeed",
        "//libc/src/termios:cfgetospeed",
        "//libc/src/termios:cfsetispeed",
        "//libc/src/termios:cfsetospeed",
        "//libc/src/termios:tcgetattr",
        "//libc/src/termios:tcgetsid",
        "//libc/src/termios:tcsetattr",
        "//libc/src/unistd:close",
    ],
)

libc_test(
    name = "tcgetwinsize_test",
    srcs = ["tcgetwinsize_test.cpp"],
    deps = [
        "//libc/hdr:fcntl_macros",
        "//libc/hdr/types:struct_winsize",
        "//libc/src/__support/CPP:scope",
        "//libc/src/fcntl:open",
        "//libc/src/termios:tcgetwinsize",
        "//libc/src/unistd:close",
        "//libc/src/unistd:pipe",
    ],
)

libc_test(
    name = "tcsetwinsize_test",
    srcs = ["tcsetwinsize_test.cpp"],
    deps = [
        "//libc/hdr:fcntl_macros",
        "//libc/hdr/types:struct_winsize",
        "//libc/src/__support/CPP:scope",
        "//libc/src/fcntl:open",
        "//libc/src/termios:tcsetwinsize",
        "//libc/src/unistd:close",
        "//libc/src/unistd:pipe",
    ],
)

libc_test(
    name = "tcflush_test",
    srcs = ["tcflush_test.cpp"],
    # DO NOT SUBMIT: Function is overlay-compatible in CMake; test source uses
    # LIBC_NAMESPACE::libc_errno which breaks when libc_errno is an overlay macro.
    full_build_only = True,
    deps = [
        "//libc/hdr:fcntl_macros",
        "//libc/hdr:poll_macros",
        "//libc/hdr:sys_ioctl_macros",
        "//libc/hdr:termios_macros",
        "//libc/hdr/types:struct_pollfd",
        "//libc/src/fcntl:open",
        "//libc/src/poll",
        "//libc/src/stdio:snprintf",
        "//libc/src/sys/ioctl",
        "//libc/src/termios:tcflush",
        "//libc/src/unistd:close",
        "//libc/src/unistd:write",
    ],
)
