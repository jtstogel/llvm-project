# Tests for LLVM libc net/if functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "if_indextoname_test",
    srcs = ["linux/if_indextoname_test.cpp"],
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr:net_if_macros",
        "//libc/src/net/if:if_indextoname",
        "//libc/src/net/if:if_nametoindex",
    ],
)

libc_test(
    name = "if_nametoindex_test",
    srcs = ["linux/if_nametoindex_test.cpp"],
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/src/net/if:if_nametoindex",
    ],
)

libc_test(
    name = "if_nameindex_test",
    srcs = ["linux/if_nameindex_test.cpp"],
    full_build_only = True,
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr:net_if_macros",
        "//libc/hdr/types:struct_if_nameindex",
        "//libc/src/__support:error_or",
        "//libc/src/__support/CPP:span",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/CPP:tuple",
        "//libc/src/__support/net:linux_netlink",
        "//libc/src/net/if:if_freenameindex",
        "//libc/src/net/if:if_nameindex",
        "//libc/src/net/if:net_linux_if_nameindex_impl",
        "//libc/test/src/__support/net:linux_netlink_test_support",
    ],
)
