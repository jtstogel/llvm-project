# Tests for LLVM libc __support/File functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "dir_scan_impl_test",
    srcs = ["dir_scan_impl_test.cpp"],
    full_build_only = True,
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr/types:struct_dirent",
        "//libc/src/__support:error_or",
        "//libc/src/__support/CPP:limits",
        "//libc/src/__support/CPP:new",
        "//libc/src/__support/CPP:span",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/File:dir_scan_impl",
        "//libc/src/dirent:alphasort",
        "//libc/src/string/memory_utils",
    ],
)
