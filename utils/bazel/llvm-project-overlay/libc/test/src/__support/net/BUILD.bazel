# Tests for LLVM libc __support/net functionality.

load("//libc/test:libc_test_rules.bzl", "libc_test", "libc_test_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "byte_order_test",
    srcs = ["byte_order_test.cpp"],
    deps = [
        "//libc/src/__support:common",
        "//libc/src/__support/net:byte_order",
    ],
)

libc_test(
    name = "hex_test",
    srcs = ["hex_test.cpp"],
    deps = [
        "//libc/src/__support/CPP:optional",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/net:hex",
    ],
)

libc_test_library(
    name = "linux_netlink_test_support",
    hdrs = ["linux/netlink_test_support.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr/types:socklen_t",
        "//libc/hdr/types:ssize_t",
        "//libc/hdr/types:struct_sockaddr",
        "//libc/src/__support:common",
        "//libc/src/__support:error_or",
        "//libc/src/__support:fixedvector",
        "//libc/src/__support/CPP:optional",
        "//libc/src/__support/CPP:span",
        "//libc/src/__support/CPP:string",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/CPP:tuple",
        "//libc/src/string/memory_utils",
    ],
)
