# Tests for LLVM libc __support/HashTable functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "bitmask_test",
    srcs = ["bitmask_test.cpp"],
    deps = ["//libc/src/__support/HashTable:bitmask"],
)

libc_test(
    name = "table_test",
    srcs = ["table_test.cpp"],
    deps = [
        "//libc/src/__support/CPP:bit",
        "//libc/src/__support/HashTable:randomness",
        "//libc/src/__support/HashTable:table",
    ],
)

libc_test(
    name = "group_test",
    srcs = ["group_test.cpp"],
    deps = [
        "//libc/src/__support/CPP:bit",
        "//libc/src/__support/HashTable:bitmask",
        "//libc/src/stdlib:rand",
    ],
)
