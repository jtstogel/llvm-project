# Tests for LLVM libc wctype functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "iswctype_test",
    srcs = ["iswctype_test.cpp"],
    deps = [
        "//libc/src/wctype",
        "//libc/src/wctype:iswctype",
    ],
)

libc_test(
    name = "wctype_test",
    srcs = ["wctype_test.cpp"],
    deps = ["//libc/src/wctype"],
)
