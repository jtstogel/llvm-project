# Tests for LLVM libc sched functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "affinity_test",
    srcs = ["affinity_test.cpp"],
    deps = [
        "//libc/hdr/types:cpu_set_t",
        "//libc/hdr/types:pid_t",
        "//libc/src/__support/OSUtil:syscall",
        "//libc/src/sched:sched_getaffinity",
        "//libc/src/sched:sched_setaffinity",
    ],
)

libc_test(
    name = "cpu_alloc_test",
    srcs = ["cpu_alloc_test.cpp"],
    full_build_only = True,
    deps = [
        "//libc/hdr:sched_macros",
        "//libc/hdr/types:cpu_set_t",
        "//libc/src/sched:__sched_cpualloc",
        "//libc/src/sched:__sched_cpufree",
        "//libc/src/sched:__sched_getcpucount",
        "//libc/src/sched:__sched_getcpuisset",
        "//libc/src/sched:__sched_setcpuset",
        "//libc/src/sched:__sched_setcpuzero",
    ],
)

