# Tests for LLVM libc libgen functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "basename_test",
    srcs = ["basename_test.cpp"],
    deps = ["//libc/src/libgen:basename"],
)

libc_test(
    name = "dirname_test",
    srcs = ["dirname_test.cpp"],
    deps = ["//libc/src/libgen:dirname"],
)

libc_test(
    name = "basename_death_test",
    srcs = ["basename_death_test.cpp"],
    deps = ["//libc/src/libgen:basename"],
)

libc_test(
    name = "dirname_death_test",
    srcs = ["dirname_death_test.cpp"],
    deps = ["//libc/src/libgen:dirname"],
)
