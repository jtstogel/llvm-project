libc_test(
    name = "getpwnam_test",
    srcs = [
        "getpwnam_test.cpp",
        "pwd_test_utils.h",
    ],
    # DO NOT SUBMIT: Function is overlay-compatible in CMake; test source uses
    # LIBC_NAMESPACE::libc_errno which breaks when libc_errno is an overlay macro.
    full_build_only = True,
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr/types:gid_t",
        "//libc/hdr/types:size_t",
        "//libc/hdr/types:struct_passwd",
        "//libc/hdr/types:uid_t",
        "//libc/src/__support/File:file",
        "//libc/src/__support/File:platform_file",
        "//libc/src/pwd:endpwent",
        "//libc/src/pwd:getpwent",
        "//libc/src/pwd:getpwnam",
        "//libc/src/pwd:pwd_utils",
        "//libc/src/stdio:remove",
        "//libc/src/string:utils",
    ],
)

