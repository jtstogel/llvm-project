# Tests for LLVM libc netinet/ether functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "ether_aton_test",
    srcs = ["ether_aton_test.cpp"],
    deps = [
        "//libc/hdr/types:struct_ether_addr",
        "//libc/src/netinet/ether:ether_aton",
    ],
)

libc_test(
    name = "ether_aton_r_test",
    srcs = ["ether_aton_r_test.cpp"],
    deps = [
        "//libc/hdr/types:struct_ether_addr",
        "//libc/src/netinet/ether:ether_aton_r",
    ],
)

libc_test(
    name = "ether_ntoa_test",
    srcs = ["ether_ntoa_test.cpp"],
    deps = [
        "//libc/hdr/types:struct_ether_addr",
        "//libc/src/netinet/ether:ether_ntoa",
    ],
)

libc_test(
    name = "ether_ntoa_r_test",
    srcs = ["ether_ntoa_r_test.cpp"],
    deps = [
        "//libc/hdr/types:struct_ether_addr",
        "//libc/src/netinet/ether:ether_ntoa_r",
    ],
)
