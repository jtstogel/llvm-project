# Tests for LLVM libc sys/eventfd functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "eventfd_test",
    srcs = ["linux/eventfd_test.cpp"],
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr:fcntl_macros",
        "//libc/hdr:sys_eventfd_macros",
        "//libc/src/fcntl",
        "//libc/src/sys/eventfd",
        "//libc/src/unistd:close",
        "//libc/src/unistd:read",
    ],
)

libc_test(
    name = "eventfd_read_test",
    srcs = ["linux/eventfd_read_test.cpp"],
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr:sys_eventfd_macros",
        "//libc/hdr/types:eventfd_t",
        "//libc/src/sys/eventfd",
        "//libc/src/sys/eventfd:eventfd_read",
        "//libc/src/unistd:close",
    ],
)

libc_test(
    name = "eventfd_write_test",
    srcs = ["linux/eventfd_write_test.cpp"],
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr:sys_eventfd_macros",
        "//libc/src/sys/eventfd",
        "//libc/src/sys/eventfd:eventfd_write",
        "//libc/src/unistd:close",
        "//libc/src/unistd:read",
    ],
)
