# Tests for LLVM libc sys/wait functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "wait4_test",
    srcs = ["wait4_test.cpp"],
    deps = ["//libc/src/sys/wait:wait4"],
)

libc_test(
    name = "waitid_test",
    srcs = ["waitid_test.cpp"],
    # Passes invalid idtype_t(-1) which traps under UBSan enum checks with glibc's idtype_t in overlay mode.
    full_build_only = True,
    deps = ["//libc/src/sys/wait:waitid"],
)
