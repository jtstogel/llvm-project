# Tests for LLVM libc sys/inotify functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "inotify_init_test",
    srcs = ["linux/inotify_init_test.cpp"],
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr:sys_resource_macros",
        "//libc/hdr/types:struct_rlimit",
        "//libc/src/__support/CPP:scope",
        "//libc/src/sys/inotify:inotify_init",
        "//libc/src/sys/resource:getrlimit",
        "//libc/src/sys/resource:setrlimit",
        "//libc/src/unistd:close",
    ],
)

libc_test(
    name = "inotify_init1_test",
    srcs = ["linux/inotify_init1_test.cpp"],
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr:sys_inotify_macros",
        "//libc/src/sys/inotify:inotify_init1",
        "//libc/src/unistd:close",
    ],
)

libc_test(
    name = "inotify_add_watch_test",
    srcs = ["linux/inotify_add_watch_test.cpp"],
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr:sys_inotify_macros",
        "//libc/src/sys/inotify:inotify_add_watch",
        "//libc/src/sys/inotify:inotify_init",
        "//libc/src/unistd:close",
    ],
)

libc_test(
    name = "inotify_rm_watch_test",
    srcs = ["linux/inotify_rm_watch_test.cpp"],
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr:sys_inotify_macros",
        "//libc/src/__support/CPP:scope",
        "//libc/src/sys/inotify:inotify_add_watch",
        "//libc/src/sys/inotify:inotify_init",
        "//libc/src/sys/inotify:inotify_rm_watch",
        "//libc/src/unistd:close",
    ],
)
