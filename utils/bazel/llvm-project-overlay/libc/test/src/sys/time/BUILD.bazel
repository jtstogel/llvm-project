# Tests for LLVM libc sys/time functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "utimes_test",
    srcs = ["utimes_test.cpp"],
    deps = [
        "//libc/hdr:fcntl_macros",
        "//libc/hdr:sys_stat_macros",
        "//libc/hdr/types:struct_timeval",
        "//libc/src/fcntl:open",
        "//libc/src/stdio:remove",
        "//libc/src/sys/stat",
        "//libc/src/sys/time:utimes",
        "//libc/src/unistd:close",
    ],
)

libc_test(
    name = "getitimer_test",
    srcs = ["getitimer_test.cpp"],
    deps = [
        "//libc/hdr:sys_time_macros",
        "//libc/hdr/types:struct_itimerval",
        "//libc/src/sys/time:getitimer",
    ],
)

libc_test(
    name = "gettimeofday_test",
    srcs = ["gettimeofday_test.cpp"],
    deps = [
        "//libc/hdr/types:struct_timeval",
        "//libc/src/sys/time:gettimeofday",
    ],
)
