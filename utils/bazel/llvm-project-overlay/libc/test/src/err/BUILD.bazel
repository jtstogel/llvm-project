# Tests for LLVM libc err functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "err_test",
    srcs = ["err_test.cpp"],
    deps = ["//libc/src/err"],
)

libc_test(
    name = "errx_test",
    srcs = ["errx_test.cpp"],
    deps = ["//libc/src/err:errx"],
)

libc_test(
    name = "verr_test",
    srcs = ["verr_test.cpp"],
    deps = ["//libc/src/err:verr"],
)

libc_test(
    name = "verrx_test",
    srcs = ["verrx_test.cpp"],
    deps = ["//libc/src/err:verrx"],
)

libc_test(
    name = "warn_test",
    srcs = ["warn_test.cpp"],
    deps = ["//libc/src/err:warn"],
)

libc_test(
    name = "warnx_test",
    srcs = ["warnx_test.cpp"],
    deps = ["//libc/src/err:warnx"],
)

libc_test(
    name = "vwarn_test",
    srcs = ["vwarn_test.cpp"],
    deps = ["//libc/src/err:vwarn"],
)

libc_test(
    name = "vwarnx_test",
    srcs = ["vwarnx_test.cpp"],
    deps = ["//libc/src/err:vwarnx"],
)
