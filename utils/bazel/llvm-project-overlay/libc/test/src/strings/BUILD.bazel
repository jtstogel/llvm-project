# Tests for LLVM libc strings.h functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "ffs_test",
    srcs = ["ffs_test.cpp"],
    deps = ["//libc/src/strings:ffs"],
)

libc_test(
    name = "ffsl_test",
    srcs = ["ffsl_test.cpp"],
    deps = ["//libc/src/strings:ffsl"],
)

libc_test(
    name = "ffsll_test",
    srcs = ["ffsll_test.cpp"],
    deps = ["//libc/src/strings:ffsll"],
)

libc_test(
    name = "bcopy_test",
    srcs = ["bcopy_test.cpp"],
    deps = [
        "//libc/src/__support/CPP:span",
        "//libc/src/strings:bcopy",
        "//libc/test/UnitTest:memory_matcher",
        "//libc/test/src/string:memory_check_utils",
    ],
)

libc_test(
    name = "bcmp_test",
    srcs = ["bcmp_test.cpp"],
    deps = [
        "//libc/src/strings:bcmp",
        "//libc/test/UnitTest:test_logger",
        "//libc/test/src/string:memory_check_utils",
    ],
)

libc_test(
    name = "bzero_test",
    srcs = ["bzero_test.cpp"],
    deps = [
        "//libc/src/strings:bzero",
        "//libc/test/src/string:memory_check_utils",
    ],
)

libc_test(
    name = "index_test",
    srcs = ["index_test.cpp"],
    deps = [
        "//libc/src/strings:index",
        "//libc/test/src/string:strchr_test_helper",
    ],
)

libc_test(
    name = "rindex_test",
    srcs = ["rindex_test.cpp"],
    deps = [
        "//libc/src/strings:rindex",
        "//libc/test/src/string:strchr_test_helper",
    ],
)

libc_test(
    name = "strcasecmp_test",
    srcs = ["strcasecmp_test.cpp"],
    deps = [
        "//libc/src/strings:strcasecmp",
    ],
)

libc_test(
    name = "strcasecmp_l_test",
    srcs = ["strcasecmp_l_test.cpp"],
    full_build_only = True,
    deps = [
        "//libc/hdr:locale_macros",
        "//libc/src/locale:freelocale",
        "//libc/src/locale:newlocale",
        "//libc/src/strings:strcasecmp_l",
    ],
)

libc_test(
    name = "strncasecmp_test",
    srcs = ["strncasecmp_test.cpp"],
    deps = [
        "//libc/src/strings:strncasecmp",
    ],
)

libc_test(
    name = "strncasecmp_l_test",
    srcs = ["strncasecmp_l_test.cpp"],
    full_build_only = True,
    deps = [
        "//libc/hdr:locale_macros",
        "//libc/src/locale:freelocale",
        "//libc/src/locale:newlocale",
        "//libc/src/strings:strncasecmp_l",
    ],
)
