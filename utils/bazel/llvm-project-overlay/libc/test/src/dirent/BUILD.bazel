# Tests for LLVM libc dirent functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "alphasort_test",
    srcs = ["alphasort_test.cpp"],
    full_build_only = True,
    deps = [
        "//libc/hdr/types:struct_dirent",
        "//libc/src/dirent:alphasort",
        "//libc/src/stdlib:qsort",
        "//libc/src/string:utils",
        "//libc/src/string/memory_utils",
    ],
)

libc_test(
    name = "scandir_test",
    srcs = ["scandir_test.cpp"],
    full_build_only = True,
    deps = [
        "//libc/hdr/types:struct_dirent",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/OSUtil:path",
        "//libc/src/dirent:scandir",
        "//libc/src/stdio:asprintf",
        "//libc/src/stdio:fclose",
        "//libc/src/stdio:fopen",
        "//libc/src/stdio:remove",
        "//libc/src/stdlib:mkdtemp",
        "//libc/src/string:strcoll",
        "//libc/src/string:strdup",
        "//libc/src/unistd:rmdir",
    ],
)
