# Tests for LLVM libc regex functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "regerror_test",
    srcs = ["regerror_test.cpp"],
    full_build_only = True,
    deps = [
        "//libc/hdr:regex_macros",
        "//libc/src/regex:regerror",
    ],
)

libc_test(
    name = "regex_basic_test",
    srcs = ["regex_basic_test.cpp"],
    full_build_only = True,
    deps = [
        "//libc/hdr:regex_macros",
        "//libc/hdr/types:regex_t",
        "//libc/src/__support/CPP:scope",
        "//libc/src/regex:regcomp",
        "//libc/src/regex:regexec",
        "//libc/src/regex:regfree",
    ],
)
