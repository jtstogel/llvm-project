# Tests for LLVM libc spawn functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "posix_spawn_file_actions_test",
    srcs = ["posix_spawn_file_actions_test.cpp"],
    full_build_only = True,
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/src/spawn:file_actions",
        "//libc/src/spawn:posix_spawn_file_actions_addclose",
        "//libc/src/spawn:posix_spawn_file_actions_adddup2",
        "//libc/src/spawn:posix_spawn_file_actions_addopen",
        "//libc/src/spawn:posix_spawn_file_actions_destroy",
        "//libc/src/spawn:posix_spawn_file_actions_init",
    ],
)
